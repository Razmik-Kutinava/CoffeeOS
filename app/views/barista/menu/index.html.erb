<% content_for :content do %>
<div class="menu-page" id="menu-pos-layout">
  <div class="menu-header">
    <h1 class="menu-title">Меню</h1>
    <div class="menu-search">
      <input type="text" id="menu-search-input" placeholder="Поиск..." class="search-input" autocomplete="off">
    </div>
  </div>

  <div class="menu-pos-grid">
    <section class="menu-catalog-pane" aria-label="Каталог">
      <div id="menu-product-grid" class="menu-product-grid">
        <% @categories.each do |category| %>
          <% category_products = @products.select { |p| p.category_id == category.id } %>
          <% next if category_products.empty? %>
          <div class="menu-category-block" data-category-block="<%= category.slug %>">
            <h2 class="menu-category-title" data-category="<%= category.slug %>"><%= category.name %></h2>
            <% category_products.each do |product| %>
              <% setting = @settings_by_product_id[product.id] %>
              <% next unless setting %>
              <%= render "barista/menu/product_card", product: product, setting: setting %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%= render "barista/menu/cart_panel" %>
  </div>
</div>
<% end %>

<%= render "barista/shared/layout" %>

<style>
  .menu-page {
    max-width: none;
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #1e262c;
    gap: 16px;
  }

  .menu-title {
    font-size: 20px;
    font-weight: 500;
    color: #d4dcec;
    margin: 0;
  }

  .menu-search {
    flex: 1;
    max-width: 320px;
  }

  .search-input {
    width: 100%;
    background: #141a1f;
    border: 1px solid #1e262c;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e5e9f0;
    font-size: 13px;
    font-family: inherit;
  }

  .search-input:focus {
    outline: none;
    border-color: #2d4c66;
  }

  .menu-pos-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    gap: 20px;
    align-items: start;
  }

  .menu-catalog-pane {
    background: #141a1f;
    border: 1px solid #1e262c;
    border-radius: 12px;
    padding: 16px;
  }

  .menu-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }

  .menu-category-block {
    display: contents;
  }

  .menu-category-title {
    grid-column: 1 / -1;
    margin: 8px 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: #9aa8b9;
  }

  .menu-product-card {
    background: #0f1214;
    border: 1px solid #1e262c;
    border-radius: 12px;
    padding: 12px;
    transition: border-color 0.15s ease;
  }

  .menu-product-card:hover {
    border-color: #2d4c66;
  }

  .menu-product-card__media {
    aspect-ratio: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #1a1f24;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-product-card__media--placeholder {
    font-size: 28px;
  }

  .menu-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-product-card__name {
    font-size: 13px;
    font-weight: 500;
    color: #d4dcec;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .menu-product-card__price {
    font-size: 14px;
    font-weight: 600;
    color: #7bc5f0;
  }

  .menu-cart-panel {
    background: #141a1f;
    border: 1px solid #1e262c;
    border-radius: 12px;
    padding: 16px;
    position: sticky;
    top: 12px;
  }

  .menu-cart-panel__title {
    font-size: 18px;
    font-weight: 600;
    color: #d4dcec;
    margin: 0 0 16px;
  }

  .menu-cart-panel__items {
    min-height: 120px;
    max-height: 40vh;
    overflow-y: auto;
    margin-bottom: 16px;
  }

  .menu-cart-panel__empty {
    color: #6e7b8c;
    text-align: center;
    padding: 32px 8px;
    font-size: 13px;
  }

  .menu-cart-panel__line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: #0f1214;
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .menu-cart-panel__line-name {
    font-size: 13px;
    color: #e5e9f0;
  }

  .menu-cart-panel__line-price {
    font-size: 12px;
    color: #9aa8b9;
    white-space: nowrap;
  }

  .menu-cart-panel__totals {
    border-top: 1px solid #1e262c;
    padding-top: 12px;
    margin-bottom: 16px;
  }

  .menu-cart-panel__total-row {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 700;
    color: #d4dcec;
  }

  .menu-cart-panel__pay {
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    background: #2d4c66;
    color: #9aa8b9;
    cursor: not-allowed;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .menu-pos-grid {
      grid-template-columns: 1fr;
    }

    .menu-cart-panel {
      position: static;
    }
  }
</style>

<script>
  // Turbo Drive: DOMContentLoaded не повторяется на visit — вешаем на turbo:load + сразу.
  function bindMenuSearch() {
    const searchInput = document.getElementById("menu-search-input");
    if (!searchInput || searchInput.dataset.bound === "1") return;
    searchInput.dataset.bound = "1";

    searchInput.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase();
      document.querySelectorAll("[data-category-block]").forEach((block) => {
        let visible = 0;
        block.querySelectorAll("[data-menu-product-card]").forEach((card) => {
          const productName = card.dataset.productName || "";
          const show = productName.includes(query);
          card.style.display = show ? "" : "none";
          if (show) visible += 1;
        });
        block.style.display = visible > 0 ? "contents" : "none";
      });
    });
  }

  document.addEventListener("DOMContentLoaded", bindMenuSearch);
  document.addEventListener("turbo:load", bindMenuSearch);
  bindMenuSearch();
</script>
