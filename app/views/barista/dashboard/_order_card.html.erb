<%
  next_status = barista_next_status(order.status)
  primary_item = order.order_items.first
  mods = primary_item ? barista_modifier_tags(primary_item) : { added: [], removed: [] }
  modifier_label = barista_board_modifier_label(mods)
  cancellable = order.can_be_cancelled?
  card_status_class = "board-slot-card--#{order.status}"
%>

<div class="board-slot-card <%= card_status_class %>" id="order_<%= order.id %>" data-controller="order-card-cancel">
  <% if next_status %>
    <%= button_to update_status_barista_order_path(order, status: next_status),
        method: :patch,
        class: "board-slot-tap",
        form: { class: "board-slot-tap-form" },
        data: { turbo_method: :patch } do %>
      <div class="board-slot-label">Табло заказа</div>
      <div class="board-slot-number">№ <%= order.order_number %></div>
      <% if order.customer_name.present? %>
        <div class="board-slot-customer"><%= order.customer_name %></div>
      <% end %>
      <% if primary_item %>
        <div class="board-slot-product"><%= primary_item.product_name %></div>
      <% end %>
      <% if modifier_label.present? %>
        <div class="board-slot-modifier"><%= modifier_label %></div>
      <% end %>
    <% end %>
  <% else %>
    <div class="board-slot-tap board-slot-tap--static">
      <div class="board-slot-label">Табло заказа</div>
      <div class="board-slot-number">№ <%= order.order_number %></div>
    </div>
  <% end %>

  <% if cancellable %>
    <button type="button"
            class="board-slot-cancel"
            aria-label="Отменить заказ"
            data-action="order-card-cancel#open"
            onclick="event.stopPropagation();">✕</button>
    <div class="order-card-cancel-overlay" data-order-card-cancel-target="overlay" hidden>
      <div class="order-card-cancel-panel">
        <p class="order-card-cancel-title">СТОП! ЗАКАЗ ОТМЕНЁН</p>
        <p class="order-card-cancel-hint">Подтвердите снятие заказа с табло</p>
        <div class="order-card-cancel-actions">
          <%= button_to "ПОДТВЕРДИТЬ ОТМЕНУ",
              cancel_barista_order_path(order),
              method: :post,
              params: { reason: "Отменено баристой", reason_code: "barista_cancel" },
              class: "card-btn-cancel-confirm",
              data: { turbo_method: :post } %>
          <button type="button"
                  class="card-btn-cancel-back"
                  data-action="order-card-cancel#close">
            Назад
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
