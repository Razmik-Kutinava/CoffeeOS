<%
  status_start_time = order_status_start_time(order)
  minutes_in_status = ((Time.current - status_start_time) / 60).floor
  timer_class = if minutes_in_status > 10
    "timer-critical"
  elsif minutes_in_status > 5
    "timer-warning"
  else
    ""
  end
  card_status_class = "card--#{order.status}"
  cancellable = order.can_be_cancelled?
%>

<div class="card order-card <%= card_status_class %>" id="order_<%= order.id %>" data-controller="order-card-cancel">
  <div class="card-body">
    <div class="card-header">
      <span class="order-number">#<%= order.order_number %></span>
      <div class="card-header-end">
        <span class="order-created"><%= l(order.created_at, format: :short) %></span>
        <% if cancellable %>
          <button type="button"
                  class="card-cancel-trigger"
                  aria-label="Отменить заказ"
                  data-action="order-card-cancel#open">✕</button>
        <% end %>
      </div>
    </div>

    <div class="card-timer-row">
      <span class="order-timer <%= timer_class %>" data-time="<%= status_start_time.iso8601 %>">⏱️ <%= minutes_in_status %> мин</span>
    </div>

    <div class="card-items">
      <% order.order_items.limit(4).each do |item| %>
        <% mods = barista_modifier_tags(item) %>
        <div class="item-block">
          <div class="item-row">
            <span class="item-qty"><%= item.quantity %>×</span>
            <span class="item-name"><%= item.product_name %></span>
          </div>
          <% if mods[:added].any? || mods[:removed].any? %>
            <div class="item-mods">
              <% mods[:added].each do |mod| %>
                <span class="mod-added">+ <%= mod["name"].to_s.upcase %></span>
              <% end %>
              <% mods[:removed].each do |mod| %>
                <span class="mod-removed">БЕЗ <%= mod["name"] %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if order.order_items.size > 4 %>
        <div class="item-more">...ещё <%= order.order_items.size - 4 %></div>
      <% end %>
    </div>
  </div>

  <div class="card-actions">
    <% next_status = barista_next_status(order.status) %>
    <% if next_status %>
      <%= button_to barista_status_button_label(order.status),
          update_status_barista_order_path(order, status: next_status),
          method: :patch,
          class: "card-btn-status card-btn-status--#{order.status}",
          data: { turbo_method: :patch },
          onclick: "event.stopPropagation();" %>
    <% end %>
  </div>

  <% if cancellable %>
    <div class="order-card-cancel-overlay" data-order-card-cancel-target="overlay" hidden>
      <div class="order-card-cancel-panel">
        <p class="order-card-cancel-title">СТОП! ЗАКАЗ ОТМЕНЁН</p>
        <p class="order-card-cancel-hint">Подтвердите снятие заказа с табло</p>
        <div class="order-card-cancel-actions">
          <%= button_to "ПОДТВЕРДИТЬ ОТМЕНУ",
              cancel_barista_order_path(order),
              method: :post,
              params: { reason: "Отменено баристой", reason_code: "barista_cancel" },
              class: "card-btn-cancel-confirm",
              data: { turbo_method: :post } %>
          <button type="button"
                  class="card-btn-cancel-back"
                  data-action="order-card-cancel#close">
            Назад
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
