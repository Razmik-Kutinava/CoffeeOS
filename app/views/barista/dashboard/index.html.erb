<% content_for :content do %>
<div class="dashboard-page">
  <div class="dashboard-header">
    <h1 class="dashboard-title">📋 Табло заказов</h1>
    <div class="dashboard-meta">
      <span class="dashboard-time">⏰ <%= Time.current.strftime('%H:%M') %></span>
      <span class="dashboard-stats">На табло: <%= @slot_counts[:total] %> / <%= Barista::BoardOrdersQuery::MAX_SLOTS %></span>
    </div>
  </div>

  <%= render partial: "barista/dashboard/board_slots", locals: { orders: @board_orders } %>

  <div class="dashboard-footer">
    <div class="footer-stats">
      <span>Новые: <strong id="count-accepted"><%= @slot_counts[:accepted] %></strong></span>
      <span>В работе: <strong id="count-preparing"><%= @slot_counts[:preparing] %></strong></span>
      <span>Всего на табло: <strong id="total-on-board"><%= @slot_counts[:total] %></strong></span>
    </div>
    <div class="footer-hint">💡 Коснитесь карточки: белая → в работу (жёлтая) → готово (исчезает с табло)</div>
  </div>

  <%= turbo_stream_from "orders_#{Current.tenant_id}" %>
</div>
<% end %>

<%= render 'barista/shared/layout' %>
