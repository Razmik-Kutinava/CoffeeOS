<% tid = Current.tenant_id %>
<% column_id = barista_column_dom_id(@old_status) %>
<% if column_id %>
  <%= turbo_stream.replace column_id do %>
    <%= render partial: "barista/dashboard/orders_column",
               locals: {
                 column_id: column_id,
                 orders: Barista::BoardOrdersQuery.for_column(tenant_id: tid, status: @old_status)
               } %>
  <% end %>
<% end %>

<%= turbo_stream.replace "count-new" do %>
  <%= render partial: "barista/dashboard/count_badge", locals: { count: Order.for_barista_board(tid).where(status: "accepted").count, type: "new" } %>
<% end %>

<%= turbo_stream.replace "count-preparing" do %>
  <%= render partial: "barista/dashboard/count_badge", locals: { count: Order.for_barista_board(tid).where(status: "preparing").count, type: "preparing" } %>
<% end %>

<%= turbo_stream.replace "count-ready" do %>
  <%= render partial: "barista/dashboard/count_badge", locals: { count: Order.for_barista_board(tid).where(status: "ready").count, type: "ready" } %>
<% end %>
