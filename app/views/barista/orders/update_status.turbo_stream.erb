<% tid = Current.tenant_id %>
<%= turbo_stream.replace "barista-board-slots" do %>
  <%= render partial: "barista/dashboard/board_slots",
             locals: { orders: Barista::BoardOrdersQuery.for_slots(tenant_id: tid) } %>
<% end %>

<% counts = Barista::BoardOrdersQuery.slot_counts(tenant_id: tid) %>
<%= turbo_stream.replace "count-accepted" do %><%= counts[:accepted] %><% end %>
<%= turbo_stream.replace "count-preparing" do %><%= counts[:preparing] %><% end %>
<%= turbo_stream.replace "total-on-board" do %><%= counts[:total] %><% end %>
