<div class="barista-layout" data-controller="barista-board-sound">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <h1>☕ CoffeeOS</h1>
    </div>
    
    <nav class="nav">
      <%= link_to barista_dashboard_path, class: "nav-item #{'active' if request.path == barista_dashboard_path}" do %>
        <span class="emoji">📋</span>
        <span>Заказы</span>
      <% end %>
      <%= link_to barista_new_order_path, class: "nav-item #{'active' if request.path == barista_new_order_path}" do %>
        <span class="emoji">➕</span>
        <span>Создать</span>
      <% end %>
      <%= link_to barista_menu_path, class: "nav-item #{'active' if request.path == barista_menu_path}" do %>
        <span class="emoji">📖</span>
        <span>Меню</span>
      <% end %>
      <%= link_to barista_shift_path, class: "nav-item #{'active' if request.path == barista_shift_path}" do %>
        <span class="emoji">⏰</span>
        <span>Смена</span>
      <% end %>
      <%= link_to barista_reports_path, class: "nav-item #{'active' if request.path == barista_reports_path}" do %>
        <span class="emoji">📊</span>
        <span>Отчёты</span>
      <% end %>
      <div style="flex: 1;"></div>
      <%= link_to '#', class: "nav-item" do %>
        <span class="emoji">⚙️</span>
        <span>Настройки</span>
      <% end %>
    </nav>

    <div class="user-section">
      <div class="user-avatar"><%= current_user.name&.first&.upcase || 'U' %></div>
      <div class="user-info">
        <div class="user-name"><%= current_user.name %></div>
        <div class="user-role">бариста</div>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <!-- STATUS BAR -->
    <div class="status-bar">
      <div class="status-bar-header">
        <% if @shift %>
          <span class="dot"></span>
          <span class="status-bar-title">● Смена открыта с <%= @shift.opened_at.strftime('%H:%M') %></span>
        <% else %>
          <span class="dot" style="background: #f07c7c; box-shadow: 0 0 8px #f07c7c80;"></span>
          <span class="status-bar-title">● Смена закрыта — откройте на вкладке «Смена»</span>
        <% end %>
        <span class="status-bar-tenant">Точка: <%= current_user.tenant&.name || 'Не указана' %></span>
      </div>
      <div class="status-bar-user">
        <span>👤 <%= current_user.name %></span>
        <%= button_to logout_path, method: :delete, data: { turbo_method: :delete }, class: "logout-btn-header", style: "background: transparent; border: none; cursor: pointer; color: #6e7b8c; padding: 4px 8px; border-radius: 4px; transition: all 0.15s;" do %>
          Выйти
        <% end %>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content" id="content">
      <%= content_for?(:content) ? yield(:content) : yield %>
    </div>
  </main>

  <!-- MODAL (order detail) -->
  <div class="modal-overlay" id="modal-order-detail">
    <div class="modal">
      <div class="modal-header">
        <h2 id="modal-order-number">order #</h2>
        <div class="modal-close" onclick="closeModal('order-detail')">✕</div>
      </div>
      <div class="modal-body" id="modal-order-body">
        <!-- dynamic -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="closeModal('order-detail')">close</button>
        <button class="btn btn-success" onclick="printReceipt()">print receipt</button>
      </div>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div class="toast-container" id="toast"></div>

  <div class="barista-sound-banner"
       id="barista-sound-blocked-banner"
       data-barista-board-sound-target="banner"
       data-action="click->barista-board-sound#dismissBanner"
       hidden
       aria-hidden="true"
       role="alert">
    Звук заблокирован. Кликните по экрану для включения
  </div>
</div>

<style>
  /* ===== RESET & GLOBALS ===== */
  .barista-layout {
    background: #0b0d0e;
    font-family: 'SF Mono', 'JetBrains Mono', 'Fira Code', monospace;
    color: #e5e9f0;
    height: 100vh;
    display: flex;
    overflow: hidden;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== SIDEBAR ===== */
  .sidebar {
    width: 180px;
    background: #0f1214;
    border-right: 1px solid #1e262c;
    display: flex;
    flex-direction: column;
    padding: 0;
    flex-shrink: 0;
  }

  .sidebar-header {
    padding: 20px 16px;
    border-bottom: 1px solid #1e262c;
  }

  .sidebar-header h1 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: #d4dcec;
    margin: 0;
  }

  .nav {
    flex: 1;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    color: #9aa8b9;
    font-size: 14px;
    margin-bottom: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
    background: transparent;
    width: 100%;
    text-align: left;
    font-family: inherit;
  }

  .nav-item:hover {
    background: #1a2126;
    color: #d4dcec;
    border-color: #2d3a44;
  }

  .nav-item.active {
    background: #1e2a33;
    color: #7bc5f0;
    border-color: #2d4c66;
  }

  .nav-item .emoji {
    font-size: 18px;
    filter: grayscale(0.3);
  }

  .user-section {
    padding: 16px;
    border-top: 1px solid #1e262c;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: #1e2a33;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7bc5f0;
    border: 1px solid #2d4c66;
    font-size: 14px;
    font-weight: 600;
  }

  .user-info {
    flex: 1;
  }

  .user-name {
    font-size: 13px;
    font-weight: 500;
    color: #d4dcec;
  }

  .user-role {
    font-size: 11px;
    color: #6e7b8c;
  }

  .logout-btn {
    color: #6e7b8c;
    cursor: pointer;
    font-size: 18px;
    transition: color 0.15s;
    text-decoration: none;
  }
  .logout-btn:hover { color: #f07c7c; }
  
  .logout-btn-header {
    color: #6e7b8c;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.15s;
  }
  .logout-btn-header:hover { 
    color: #f07c7c; 
    background: #1e262c;
  }

  /* ===== MAIN PANEL ===== */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0b0d0e;
  }

  .status-bar {
    height: 60px;
    background: #0f1214;
    border-bottom: 1px solid #1e262c;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    font-size: 13px;
    color: #9aa8b9;
  }
  
  .status-bar-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  
  .status-bar-title {
    font-size: 16px;
    font-weight: 500;
    color: #d4dcec;
  }
  
  .status-bar-time {
    color: #6e7b8c;
  }
  
  .status-bar-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .status-bar-tenant {
    color: #9aa8b9;
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 10px;
    background: #3a9b5e;
    box-shadow: 0 0 8px #3a9b5e80;
  }

  .status-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stat-value {
    color: #d4dcec;
    font-weight: 500;
  }

  /* ===== CONTENT AREA ===== */
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    scrollbar-width: thin;
    scrollbar-color: #2d3a44 #0f1214;
  }

  .content::-webkit-scrollbar {
    width: 6px;
  }
  .content::-webkit-scrollbar-track {
    background: #0f1214;
  }
  .content::-webkit-scrollbar-thumb {
    background: #2d3a44;
    border-radius: 4px;
  }

  /* ===== DASHBOARD PAGE ===== */
  .dashboard-page {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #1e262c;
  }
  
  .dashboard-title {
    font-size: 20px;
    font-weight: 500;
    color: #d4dcec;
    margin: 0;
  }
  
  .dashboard-meta {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: #6e7b8c;
  }
  
  .dashboard-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid #1e262c;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .footer-stats {
    display: flex;
    gap: 24px;
    font-size: 13px;
    color: #9aa8b9;
  }
  
  .footer-stats strong {
    color: #d4dcec;
    font-weight: 500;
  }
  
  .footer-hint {
    font-size: 12px;
    color: #6e7b8c;
  }

  /* ===== B2.1 REVISION — 6 SLOT BOARD ===== */
  .board-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 16px;
    flex: 1;
    min-height: 0;
    padding: 4px 0;
  }

  .board-slot {
    min-height: 200px;
    min-width: 0;
  }

  .board-slot-empty {
    height: 100%;
    min-height: 200px;
    border: 2px dashed #2d3a44;
    border-radius: 12px;
    background: rgba(15, 18, 20, 0.5);
  }

  .board-slot-card {
    position: relative;
    height: 100%;
    min-height: 200px;
    border-radius: 12px;
    border: 2px solid #c8c8c0;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .board-slot-card--accepted {
    background: #f5f5eb;
    border-color: #d8d8cc;
    color: #1a1a1a;
  }

  .board-slot-card--preparing {
    background: #fff59d;
    border-color: #e6d84a;
    color: #1a1a1a;
  }

  .board-slot-tap-form {
    margin: 0;
    height: 100%;
    width: 100%;
  }

  .board-slot-tap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    min-height: 196px;
    padding: 16px 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    text-align: center;
  }

  .board-slot-tap--static {
    cursor: default;
  }

  .board-slot-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #5a5a52;
  }

  .board-slot-number {
    font-size: 18px;
    font-weight: 800;
    color: #1a1a1a;
  }

  .board-slot-customer {
    font-size: 14px;
    font-weight: 600;
    color: #2a2a2a;
  }

  .board-slot-product {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: #333;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .board-slot-modifier {
    font-size: 12px;
    font-weight: 700;
    color: #4a4a00;
  }

  .board-slot-cancel {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 2;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid #999;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.85);
    color: #a04040;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
  }

  .board-slot-card .order-card-cancel-overlay {
    background: rgba(28, 32, 36, 0.94);
  }

  /* ===== KANBAN BOARD (legacy) ===== */
  .kanban {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    flex: 1;
    min-height: 0;
  }

  .column {
    background: #0f1214;
    border-radius: 12px;
    border: 1px solid #1e262c;
    display: flex;
    flex-direction: column;
    min-height: 500px;
    max-height: calc(100vh - 250px);
    overflow: hidden;
  }

  .column-header {
    padding: 16px;
    border-bottom: 1px solid #1e262c;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .column-title {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .column-title > span:first-of-type {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #d4dcec;
  }
  
  .column-subtitle {
    font-size: 11px;
    color: #6e7b8c;
    margin-left: 18px;
  }
  
  .empty-column {
    text-align: center;
    padding: 40px 20px;
    color: #6e7b8c;
    font-size: 13px;
  }

  .column-dot {
    width: 10px;
    height: 10px;
    border-radius: 10px;
  }
  .dot-new { background: #7bc5f0; box-shadow: 0 0 8px #7bc5f080; }
  .dot-prep { background: #f0c97c; box-shadow: 0 0 8px #f0c97c80; }
  .dot-ready { background: #7cf0a0; box-shadow: 0 0 8px #7cf0a080; }

  .column-count {
    background: #1e262c;
    color: #9aa8b9;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
  }

  .cards {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #2d3a44 #0f1214;
  }
  
  .cards::-webkit-scrollbar {
    width: 6px;
  }
  .cards::-webkit-scrollbar-track {
    background: #0f1214;
  }
  .cards::-webkit-scrollbar-thumb {
    background: #2d3a44;
    border-radius: 4px;
  }

  /* ===== ORDER CARD (B2.1) ===== */
  .order-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    border-radius: 12px;
    border: 2px solid #1e262c;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .order-card.card--accepted {
    background: linear-gradient(180deg, rgba(30, 100, 180, 0.35) 0%, #141a1f 45%);
    border-color: #3d7ab8;
  }
  .order-card.card--preparing {
    background: linear-gradient(180deg, rgba(230, 140, 40, 0.35) 0%, #141a1f 45%);
    border-color: #c87830;
  }
  .order-card.card--ready {
    background: linear-gradient(180deg, rgba(60, 180, 100, 0.35) 0%, #141a1f 45%);
    border-color: #3a9b5e;
  }

  .order-card .card-body {
    flex: 1;
    padding: 14px 14px 8px;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .order-card .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }

  .card-header-end {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .card-cancel-trigger {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid #4a5568;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.35);
    color: #f0a0a0;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
  }

  .card-cancel-trigger:hover {
    background: rgba(180, 50, 50, 0.45);
    border-color: #c05050;
  }

  .order-card-cancel-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(28, 32, 36, 0.94);
    padding: 16px;
  }

  .order-card-cancel-overlay.is-visible {
    display: flex;
  }

  .order-card-cancel-panel {
    text-align: center;
    width: 100%;
  }

  .order-card-cancel-title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #f5f5f5;
    text-transform: uppercase;
  }

  .order-card-cancel-hint {
    margin: 0 0 16px;
    font-size: 12px;
    color: #9aa8b9;
  }

  .order-card-cancel-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .order-card-cancel-actions form {
    margin: 0;
    width: 100%;
  }

  .card-btn-cancel-confirm {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #5a5a5a;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    font-family: inherit;
  }

  .card-btn-cancel-confirm:hover {
    background: #6e6e6e;
  }

  .card-btn-cancel-back {
    width: 100%;
    min-height: 44px;
    padding: 10px;
    border: 1px solid #4a5568;
    border-radius: 8px;
    background: transparent;
    color: #b6c4d4;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }

  .order-number {
    font-weight: 700;
    color: #f0f4fa;
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .order-created {
    font-size: 11px;
    color: #9aa8b9;
    white-space: nowrap;
  }

  .card-timer-row {
    margin-bottom: 10px;
  }

  .order-timer {
    font-size: 12px;
    color: #9aa8b9;
  }
  .timer-critical { color: #f07c7c; font-weight: 600; }
  .timer-warning { color: #f0c97c; font-weight: 600; }

  .card-items {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .item-block {
    margin-bottom: 8px;
  }

  .item-row {
    display: flex;
    gap: 6px;
    font-size: 13px;
    color: #e5e9f0;
    line-height: 1.35;
  }

  .item-qty {
    color: #fff;
    font-weight: 700;
    min-width: 22px;
  }

  .item-name {
    font-weight: 500;
  }

  .item-mods {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
    margin-left: 28px;
  }

  .mod-added {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #1a1200;
    background: #ffc857;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .mod-removed {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    color: #9aa8b9;
    text-decoration: line-through;
    text-transform: uppercase;
  }

  .item-more {
    color: #6e7b8c;
    font-size: 12px;
    font-style: italic;
    margin-top: 4px;
  }

  .order-card .card-actions {
    padding: 0;
    margin: 0;
    flex-shrink: 0;
  }

  .order-card .card-actions form {
    margin: 0;
    width: 100%;
  }

  .card-btn-status {
    display: block;
    width: 100%;
    min-height: 80px;
    padding: 12px 16px;
    border: none;
    border-radius: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: filter 0.15s ease, transform 0.1s ease;
  }

  .card-btn-status:hover {
    filter: brightness(1.12);
  }
  .card-btn-status:active {
    transform: scale(0.99);
  }

  .card-btn-status--accepted {
    background: linear-gradient(180deg, #4a9fd4 0%, #2d6a9f 100%);
    color: #fff;
  }
  .card-btn-status--preparing {
    background: linear-gradient(180deg, #f0a040 0%, #c87820 100%);
    color: #1a1000;
  }
  .card-btn-status--ready {
    background: linear-gradient(180deg, #5cd68a 0%, #2d9b5a 100%);
    color: #0a1a10;
  }

  /* legacy .card / .btn — другие экраны бариста */
  .card:not(.order-card) {
    background: #141a1f;
    border: 1px solid #1e262c;
    border-radius: 10px;
    padding: 16px;
  }

  .btn {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid transparent;
    background: transparent;
    color: #b6c4d4;
    cursor: pointer;
    font-family: inherit;
  }

  /* ===== MODAL ===== */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal {
    background: #141a1f;
    border: 1px solid #2d4c66;
    border-radius: 16px;
    width: 480px;
    max-width: 90vw;
    max-height: 80vh;
    overflow-y: auto;
  }

  .modal-header {
    padding: 20px;
    border-bottom: 1px solid #1e262c;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    font-size: 18px;
    font-weight: 500;
    color: #d4dcec;
  }

  .modal-close {
    cursor: pointer;
    color: #6e7b8c;
    font-size: 24px;
  }

  .modal-body {
    padding: 20px;
  }

  .modal-footer {
    padding: 20px;
    border-top: 1px solid #1e262c;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  /* ===== TOAST ===== */
  .toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .toast {
    background: #1e2a33;
    border-left: 4px solid #7bc5f0;
    border-radius: 6px;
    padding: 12px 20px;
    color: #e5e9f0;
    font-size: 13px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.5);
    animation: slideIn 0.2s ease;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
  }

  .barista-sound-banner {
    position: fixed;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3000;
    max-width: min(520px, 92vw);
    padding: 14px 20px;
    border-radius: 10px;
    background: #3d2a14;
    border: 2px solid #f0c97c;
    color: #fff8e8;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .barista-sound-banner[hidden] {
    display: none !important;
  }
</style>

<script>
  // Navigation is handled by Rails links now

  function closeModal(modalId) {
    const modal = document.getElementById(`modal-${modalId}`);
    if (modal) {
      modal.classList.remove('active');
    }
  }
  
  function openModal(modalId) {
    const modal = document.getElementById(`modal-${modalId}`);
    if (modal) {
      modal.classList.add('active');
    }
  }
  
  function closePaymentModal() {
    const modal = document.getElementById('modal-payment');
    if (modal) {
      modal.classList.remove('active');
    }
  }
  
  function showToast(message, type = 'info') {
    const toastContainer = document.getElementById('toast');
    if (!toastContainer) return;
    
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    
    const colors = {
      success: '#7cf0a0',
      error: '#f07c7c',
      warning: '#f0c97c',
      info: '#7bc5f0'
    };
    
    toast.style.borderLeftColor = colors[type] || colors.info;
    toastContainer.appendChild(toast);
    
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 200);
    }, 3000);
  }

  function showOrderDetail(orderId) {
    fetch(`/barista/orders/${orderId}.json`)
      .then(response => response.json())
      .then(data => {
        document.getElementById('modal-order-number').textContent = `order ${data.order_number}`;
        
        const itemsHtml = data.order_items.map(item => {
          const mods = item.modifiers && item.modifiers.length > 0 ? item.modifiers.join(', ') : '—';
          return `
            <tr>
              <td style="padding: 6px 0;">${item.quantity}× ${item.product_name}<br><span style="color:#6e7b8c;font-size:0.85em;">${mods}</span></td>
              <td></td>
              <td style="text-align: right;">${(item.price * item.quantity).toLocaleString('ru-RU')} ₽</td>
            </tr>
          `;
        }).join('');

        document.getElementById('modal-order-body').innerHTML = `
          <div style="margin-bottom: 20px;">
            <div style="display: flex; gap: 20px; margin-bottom: 16px;">
              <div><span style="color: #6e7b8c;">source</span><br>${data.source === 'kiosk' ? 'kiosk' : data.source === 'app' ? 'app' : 'manual'}</div>
              <div><span style="color: #6e7b8c;">status</span><br>${data.status}</div>
            </div>
            <table style="width: 100%; border-collapse: collapse;">
              <thead style="border-bottom: 1px solid #1e262c;">
                <tr><th style="text-align: left;">item</th><th>mod</th><th style="text-align: right;">price</th></tr>
              </thead>
              <tbody>${itemsHtml}</tbody>
              <tfoot style="border-top: 1px solid #1e262c;">
                <tr><td colspan="2" style="padding-top: 12px;">total</td><td style="text-align: right; font-weight: bold;">${data.final_amount.toLocaleString('ru-RU')} ₽</td></tr>
              </tfoot>
            </table>
          </div>
        `;
        
        document.getElementById('modal-order-detail').classList.add('active');
      })
      .catch(error => {
        console.error('Error loading order:', error);
      });
  }

  function printReceipt() {
    // TODO: Implement receipt printing
    console.log('Print receipt');
  }

  // Close modal on overlay click
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal-order-detail');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) closeModal('order-detail');
      });
    }
  });
</script>
