<%# #77 УК: настройки оффера подписки на точке %>
<div class="space-y-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Оффер подписки — <%= @tenant.name %></h1>
    <p class="mt-1 text-sm text-slate-600">Вторая CTA на статусе «готов» и порог толерантности гостя.</p>
  </div>

  <%= form_with model: @setting,
      url: platform_tenant_subscription_offer_setting_path(@tenant),
      method: :patch,
      class: "space-y-4 max-w-lg" do |f| %>
    <% if @setting.errors.any? %>
      <div class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-800">
        <%= @setting.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :enabled, class: "rounded border-slate-300" %>
      <span>Включить оффер подписки на точке</span>
    </label>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Вторая CTA</label>
      <%= f.select :second_cta_mode,
          [["Чаевые", "tips"], ["Подписка", "subscription"]],
          {},
          class: "w-full rounded border-slate-300 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Мин. завершённых заказов</label>
      <%= f.number_field :min_completed_orders, min: 1, class: "w-full rounded border-slate-300 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Порог толерантности (сигналов 1–3)</label>
      <%= f.number_field :required_signals_count, min: 1, max: 3, class: "w-full rounded border-slate-300 text-sm" %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Сохранить", class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
      <%= link_to "К точке", platform_tenant_path(@tenant), class: "text-sm text-slate-600 underline" %>
    </div>
  <% end %>
</div>
