<p style="margin-bottom: 16px;">
  <%= link_to "← Мониторинг", platform_monitoring_path, style: "color: #93c5fd;" %>
  · <%= link_to "Session JSON", platform_session_path(format: :json), style: "color: #93c5fd;", target: "_blank", rel: "noopener" %>
</p>

<h1 style="font-size: 1.5rem; margin-bottom: 16px;">Моя сессия</h1>

<div style="border: 1px solid #334155; border-radius: 8px; background: #1a1f2e; padding: 16px; max-width: 520px; margin-bottom: 16px;">
  <dl style="margin: 0; display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; font-size: 13px;">
    <dt style="color: #64748b;">Email</dt>
    <dd style="margin: 0;"><%= @session_info.to_h[:email] %></dd>
    <dt style="color: #64748b;">Имя</dt>
    <dd style="margin: 0;"><%= @session_info.to_h[:name] %></dd>
    <dt style="color: #64748b;">User ID</dt>
    <dd style="margin: 0; word-break: break-all; color: #93c5fd;"><%= @session_info.to_h[:user_id] %></dd>
    <dt style="color: #64748b;">Роль</dt>
    <dd style="margin: 0;"><%= @session_info.to_h[:role_code] || "—" %></dd>
    <dt style="color: #64748b;">Tenant ID</dt>
    <dd style="margin: 0; word-break: break-all;"><%= @session_info.to_h[:tenant_id] %></dd>
    <dt style="color: #64748b;">Вход</dt>
    <dd style="margin: 0;"><%= @session_info.to_h[:logged_in_at].present? ? monitoring_event_time(@session_info.to_h[:logged_in_at]) : "— (перелогиньтесь)" %></dd>
  </dl>
</div>

<div style="max-width: 720px; border: 1px solid #334155; border-radius: 8px; overflow: hidden; background: #1a1f2e;">
  <%= render "platform/monitoring/json_details", payload: @session_info.to_h %>
</div>
