<h1 style="font-size: 1.5rem; margin-bottom: 8px;">Мониторинг точек</h1>
<p style="color: #94a3b8; margin-bottom: 20px; font-size: 13px;">
  Сводка по всем активным точкам · обновлено <%= l(@generated_at, format: :short) %>
  · <%= link_to "JSON API", health_tenants_path, style: "color: #93c5fd;", target: "_blank", rel: "noopener" %>
</p>

<table style="width: 100%; border-collapse: collapse; font-size: 13px;">
  <thead>
    <tr style="text-align: left; border-bottom: 1px solid #334155;">
      <th style="padding: 10px 8px;">Точка</th>
      <th style="padding: 10px 8px;">Статус</th>
      <th style="padding: 10px 8px;">Касса</th>
      <th style="padding: 10px 8px;">Очередь</th>
      <th style="padding: 10px 8px;">Витрина</th>
      <th style="padding: 10px 8px;">Оплаты</th>
      <th style="padding: 10px 8px;">Зависшие</th>
      <th style="padding: 10px 8px;">Отказы</th>
      <th style="padding: 10px 8px;"></th>
    </tr>
  </thead>
  <tbody>
    <% @summaries.each do |row| %>
      <% t = row[:tenant] %>
      <% c = row[:checks] %>
      <tr style="border-bottom: 1px solid #1e293b;">
        <td style="padding: 10px 8px;">
          <strong><%= t.name %></strong>
          <div style="color: #64748b; font-size: 11px;"><%= t.slug %></div>
        </td>
        <td style="padding: 10px 8px;"><%= monitoring_status_badge(row[:overall]) %></td>
        <td style="padding: 10px 8px;"><%= monitoring_status_badge(c[:cash_register][:status]) %></td>
        <td style="padding: 10px 8px;"><%= c[:queue][:count] %></td>
        <td style="padding: 10px 8px;"><%= c[:shop_vitrina][:count] %></td>
        <td style="padding: 10px 8px;"><%= c[:payments][:count] %></td>
        <td style="padding: 10px 8px;">
          <% if c[:pending_payment][:stuck].to_i.positive? %>
            <span style="color: #fcd34d;"><%= c[:pending_payment][:stuck] %></span>
          <% else %>
            <span style="color: #64748b;">0</span>
          <% end %>
        </td>
        <td style="padding: 10px 8px;">
          <% if c[:failed_payments][:count].to_i.positive? %>
            <span style="color: #fcd34d;"><%= c[:failed_payments][:count] %></span>
          <% else %>
            <span style="color: #64748b;">0</span>
          <% end %>
        </td>
        <td style="padding: 10px 8px;">
          <%= link_to "Подробнее", platform_monitoring_tenant_path(t), style: "color: #93c5fd;" %>
          · <%= link_to "Сессии", platform_monitoring_tenant_sessions_path(t), style: "color: #93c5fd;" %>
          · <%= link_to "Транзакции", platform_monitoring_tenant_transactions_path(t), style: "color: #93c5fd;" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @summaries.empty? %>
  <p style="color: #94a3b8; margin-top: 16px;">Нет активных точек.</p>
<% end %>
