<p style="margin-bottom: 16px;">
  <%= link_to "← Все точки", platform_monitoring_path, style: "color: #93c5fd;" %>
  · <%= link_to "JSON", health_tenant_path(@tenant), style: "color: #93c5fd;", target: "_blank", rel: "noopener" %>
  · <%= link_to "Events JSON", platform_monitoring_tenant_events_path(@tenant), style: "color: #93c5fd;", target: "_blank", rel: "noopener" %>
</p>

<h1 style="font-size: 1.5rem; margin-bottom: 4px;"><%= @tenant.name %></h1>
<p style="color: #94a3b8; margin-bottom: 20px; font-size: 13px;">
  <%= @tenant.slug %> · <%= monitoring_status_badge(@result[:overall]) %>
  · <%= l(@generated_at, format: :short) %>
</p>

<section style="margin-bottom: 28px;">
  <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Проверки и детали</h2>

  <% @result[:checks].each do |key, check| %>
    <% detail = @feed.dig(:check_details, key.to_sym) || @feed.dig(:check_details, key.to_s) %>
    <div style="margin-bottom: 20px; border: 1px solid #334155; border-radius: 8px; overflow: hidden; background: #1a1f2e;">
      <div style="padding: 12px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155;">
        <div>
          <strong style="font-size: 14px;"><%= monitoring_check_label(key) %></strong>
          <div style="color: #94a3b8; font-size: 12px; margin-top: 4px;"><%= check[:message] %></div>
        </div>
        <%= monitoring_status_badge(check[:status]) %>
      </div>

      <% if detail && detail[:rows].any? %>
        <%= render "platform/monitoring/detail_table", detail: detail %>
      <% else %>
        <div style="padding: 12px; color: #64748b; font-size: 12px;">Нет строк для показа</div>
      <% end %>
    </div>
  <% end %>
</section>

<section>
  <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Единая лента (24ч, последние <%= @feed[:unified_feed].size %>)</h2>
  <% if @feed[:unified_feed].any? %>
    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
      <thead>
        <tr style="text-align: left; border-bottom: 1px solid #334155;">
          <th style="padding: 8px;">Время</th>
          <th style="padding: 8px;">Проверка</th>
          <th style="padding: 8px;">Тип</th>
          <th style="padding: 8px;">Событие</th>
        </tr>
      </thead>
      <tbody>
        <% @feed[:unified_feed].each do |ev| %>
          <tr style="border-bottom: 1px solid #1e293b;">
            <td style="padding: 8px; color: #94a3b8; white-space: nowrap;"><%= ev[:at] %></td>
            <td style="padding: 8px;"><%= monitoring_check_label(ev[:check]) %></td>
            <td style="padding: 8px;"><%= ev[:kind] %></td>
            <td style="padding: 8px;"><%= ev[:summary] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color: #64748b; font-size: 13px;">Событий за 24 часа нет.</p>
  <% end %>
</section>
