<nav style="display: flex; gap: 16px; align-items: center; padding: 14px 24px; border-bottom: 1px solid #334155; background: #1a1f2e;">
  <strong style="letter-spacing: 0.04em;">УК — платформа</strong>
  <%= link_to "Дашборд", platform_root_path, style: "color: #93c5fd;" %>
  <%= link_to "Организации", platform_organizations_path, style: "color: #93c5fd;" %>
  <%= link_to "Точки", platform_tenants_path, style: "color: #93c5fd;" %>
  <%= link_to "Меню", platform_menu_path, style: "color: #93c5fd;" %>
  <%= link_to "Мониторинг точек", platform_monitoring_path, style: "color: #93c5fd;" %>
  <span style="flex: 1;"></span>
  <% if current_user %>
    <span style="font-size: 11px; color: #94a3b8; text-align: right; line-height: 1.4;">
      <%= current_user.email %><br>
      <span style="color: #64748b;">id: <%= current_user.id %></span>
      <% if session[:role_code].present? %>
        · <%= session[:role_code] %>
      <% end %>
      · <%= link_to "Session JSON", platform_session_path, style: "color: #93c5fd;" %>
    </span>
  <% end %>
  <span style="width: 12px;"></span>
  <%= button_to "Выйти", logout_path, method: :delete, form: { style: "display:inline;" }, style: "cursor: pointer;" %>
</nav>
