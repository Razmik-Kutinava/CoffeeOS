<%= form_with model: tenant,
    url: tenant.persisted? ? platform_tenant_path(tenant) : platform_tenants_path,
    local: true, style: "max-width: 520px;" do |f| %>
  <% if tenant.errors.any? %>
    <p style="color: #fca5a5;"><%= tenant.errors.full_messages.to_sentence %></p>
  <% end %>
  <p><%= f.label :organization_id, "Организация" %>
    <%= f.collection_select :organization_id, Organization.order(:name), :id, :display_name_for_select, { include_blank: "—" }, { style: "width: 100%;" } %></p>
  <p><%= f.label :name %> <%= f.text_field :name, required: true, style: "width: 100%;" %></p>
  <p><%= f.label :slug %> <%= f.text_field :slug, required: true, style: "width: 100%;" %>
    <span style="display: block; font-size: 12px; color: #94a3b8; margin-top: 4px;">
      Латиница, уникальный. Нельзя: <%= Platform::TenantOnboarding::UrlBuilder::RESERVED_SUBDOMAINS.join(', ') %>.
      Витрина: <code>{slug}.<%= Platform::TenantOnboarding::UrlBuilder.shop_base_domain.presence || 'SHOP_BASE_DOMAIN' %></code> или <code>?tenant_id=</code> без домена.
    </span>
  </p>
  <p><%= f.label :type %>
    <%= f.select :type, [%w[Точка\ продаж sales_point], %w[Кухня production_kitchen]] %></p>
  <p><%= f.label :status %>
    <%= f.select :status, Tenant::STATUSES.map { |k, v| [k.to_s.humanize, v] } %></p>
  <p><%= f.label :city %> <%= f.text_field :city, style: "width: 100%;" %></p>
  <p><%= f.label :address, "Адрес" %> <%= f.text_field :address, style: "width: 100%;" %></p>

  <%= render "tenant_map_fields", tenant: tenant, f: f %>

  <p><%= f.label :country %> <%= f.text_field :country, maxlength: 2, style: "width: 4rem;" %></p>
  <p><%= f.label :currency %> <%= f.text_field :currency, maxlength: 3, style: "width: 4rem;" %></p>
  <p><%= f.label :timezone %> <%= f.text_field :timezone, style: "width: 100%;" %></p>

  <%= render "weekday_schedules_fields", tenant: tenant %>

  <h2 style="font-size: 1rem; margin-top: 1.5rem;">Модули</h2>
  <% TenantModuleFlags::LABELS.each do |code, label| %>
    <% ff = tenant.persisted? ? FeatureFlag.find_by(tenant_id: tenant.id, module: code) : nil %>
    <% on = ff ? ff.enabled : true %>
    <p>
      <%= hidden_field_tag "modules[#{code}]", "0" %>
      <%= check_box_tag "modules[#{code}]", "1", on, id: "mod_#{code}" %>
      <%= label_tag "mod_#{code}", label %>
    </p>
  <% end %>

  <% if tenant.sales_point? || tenant.type.to_s == "sales_point" || tenant.new_record? %>
    <% promo = local_assigns[:card_binding_promo] || @card_binding_promo || (tenant.persisted? ? PointCampaignSetting.card_binding_promo_for(tenant.id) : nil) %>
    <h2 style="font-size: 1rem; margin-top: 1.5rem;">Промо 11₽</h2>
    <p style="font-size: 12px; color: #94a3b8;">Пилот привязки способа оплаты на этой точке. Не наследуется другими точками города.</p>
    <p>
      <%= hidden_field_tag "point_campaign[card_binding_promo_enabled]", "0" %>
      <%= check_box_tag "point_campaign[card_binding_promo_enabled]", "1", promo&.enabled?, id: "promo_11_enabled" %>
      <%= label_tag "promo_11_enabled", "Промо 11₽" %>
    </p>
    <p>
      <%= label_tag "promo_11_threshold", "Порог (сохранённых способов)" %>
      <%= number_field_tag "point_campaign[card_binding_promo_threshold]",
            promo&.threshold || PointCampaignSetting::DEFAULT_THRESHOLD,
            min: 1, id: "promo_11_threshold", style: "width: 6rem;" %>
    </p>
    <% if promo %>
      <p style="font-size: 12px; color: #94a3b8;">Счётчик: <%= promo.counter %> / <%= promo.threshold %></p>
    <% end %>
  <% end %>

  <%= f.submit tenant.persisted? ? "Сохранить" : "Создать" %>
<% end %>
