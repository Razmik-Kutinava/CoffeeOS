<section style="margin: 1.25rem 0; padding: 1rem; border: 1px solid #f59e0b; border-radius: 8px; background: #1c1917;">
  <h2 style="font-size: 1rem; margin: 0 0 0.5rem; color: #fbbf24;">Пароли сотрудников (показываются один раз)</h2>
  <p style="margin: 0 0 0.75rem; color: #a8a29e; font-size: 0.875rem;">Скопируйте и передайте сотрудникам. Вход — <code>/login</code>.</p>
  <table style="width: 100%; border-collapse: collapse; font-size: 13px; color: #fef3c7;">
    <thead>
      <tr style="text-align: left;"><th>Роль</th><th>Имя</th><th>Логин</th><th>Пароль</th></tr>
    </thead>
    <tbody>
      <% credentials.each do |c| %>
        <tr>
          <td><%= Platform::TenantTeamProvision::ROLE_LABELS[c["role"]] || c["role"] %></td>
          <td><%= c["name"] %></td>
          <td><code><%= c["login"] %></code></td>
          <td><code><%= c["password"] %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
