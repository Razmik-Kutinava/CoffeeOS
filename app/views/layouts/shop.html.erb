<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "CoffeeOS — витрина" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ff8c42">
    <% manifest_tid = shop_layout_tenant_id %>
    <%= tag.link rel: "manifest", href: shop_pwa_manifest_href(manifest_tid) %>
    <%= tag.link rel: "apple-touch-icon", href: "/pwa/apple-touch-icon.png", sizes: "180x180" %>
    <% if @shop_tenant %>
      <meta name="shop-tenant-id" content="<%= @shop_tenant.id %>">
    <% end %>
    <% if ENV["SHOP_API_KEY"].present? %>
      <meta name="shop-api-key" content="<%= ENV["SHOP_API_KEY"] %>">
    <% end %>
    <meta name="action-cable-url" content="<%= ENV.fetch("ACTION_CABLE_URL", "/cable") %>">
    <% if Shop::FirebaseConfig.client_configured? %>
      <meta name="firebase-api-key" content="<%= Shop::FirebaseConfig.api_key %>">
      <meta name="firebase-auth-domain" content="<%= Shop::FirebaseConfig.auth_domain %>">
      <meta name="firebase-project-id" content="<%= Shop::FirebaseConfig.project_id %>">
      <meta name="firebase-storage-bucket" content="<%= Shop::FirebaseConfig.storage_bucket %>">
      <meta name="firebase-messaging-sender-id" content="<%= Shop::FirebaseConfig.messaging_sender_id %>">
      <meta name="firebase-app-id" content="<%= Shop::FirebaseConfig.app_id %>">
      <% if Shop::FirebaseConfig.vapid_key.present? %>
        <meta name="firebase-vapid-key" content="<%= Shop::FirebaseConfig.vapid_key %>">
      <% end %>
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application" %>
  </head>
  <body class="min-h-screen antialiased" style="background:#1a1a1a;color:#fff;">
    <% if @shop_tenant.blank? %>
      <div style="background:#1a1a1a;color:#fff;padding:1rem;font-family:system-ui,sans-serif;">
        <p><strong>Витрина /shop</strong></p>
        <p>Задайте в <code>.env</code> переменную <code>SHOP_DEFAULT_TENANT_ID</code> (UUID точки) или откройте
          <code>/shop?tenant_id=...</code></p>
      </div>
    <% end %>
    <%= yield %>
    <script id="shop-boot-watchdog">
      (function () {
        window.setTimeout(function () {
          var sk = document.querySelector(".shop-boot-skeleton");
          if (!sk) return;
          sk.setAttribute("aria-busy", "false");
          sk.innerHTML =
            '<p class="shop-boot-message">Не удалось загрузить меню</p>' +
            '<p class="shop-boot-message">Обновите страницу и проверьте интернет.</p>' +
            '<p class="shop-boot-message"><button type="button" id="shop-boot-reload" style="background:#ff8c42;color:#1a1a1a;border:0;border-radius:8px;padding:0.6rem 1rem;font:inherit;cursor:pointer">Обновить</button></p>';
          var btn = document.getElementById("shop-boot-reload");
          if (btn) btn.onclick = function () { window.location.reload(); };
        }, 12000);
      })();
    </script>
  </body>
</html>
