# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Гемы в каталоге проекта (`path vendor/bundle`)
/vendor/bundle/
!/vendor/README.md

# Bundler: не коммитим кэш, но path к гемам — в репо (удобно для WSL без sudo)
/.bundle/*
!/.bundle/config
!/.bundle/README.md

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
!/log/README.md
/tmp/*
!/tmp/.keep
!/tmp/README.md

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
!/tmp/pids/README.md
!/tmp/sockets/README.md
!/tmp/cache/README.md
!/tmp/storage/
!/tmp/storage/.keep
!/tmp/storage/README.md

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
!/storage/README.md
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
!/tmp/storage/README.md

/public/assets

# Загрузки фото товаров УК (public/uploads/products) — локально/Fly эфемерно, в git только README
/public/uploads/
!/public/uploads/README.md
!/public/uploads/products/README.md

# Ignore key files for decrypting credentials and more.
/config/*.key
/config/secrets/*.json
!/config/secrets/.gitkeep

# Local Postgres test cluster (never commit)
/.pg_test/
!/.pg_test/README.md

# Local scratch/notes file
/qc

# Agent scratch: one-off scripts, commit msgs — только scripts/scratch/, не корень
/scripts/scratch/*
!/scripts/scratch/.keep
!/scripts/scratch/README.md
/tmp_*
/-b
/-F
/-H
/curl.exe
/*lighthouse.*
/C?Users*

# Coverage reports (e.g. SimpleCov)
/coverage/
!/coverage/README.md

# Node + Vite (витрина shop)
/node_modules/
!/node_modules/README.md
/public/vite-dev
/public/vite-test
/public/vite-ssr

# Editor/OS noise
.DS_Store
Thumbs.db

# Локальные docs/ и .claude/ не коммитим: добавь у себя в .git/info/exclude строки /docs/ и /.claude/
/benchmark

# VSCode settings
.vscode/
!.vscode/README.md

# Claude Code free-claude-code
/free-claude-code/
!/free-claude-code/README.md

# Все markdown файлы кроме README.md и doc/features/
*.md
!README.md
!doc/**/*.md
!docs/**/*.md
!.cursor/commands/**/*.md
!.cursor/skills/**/*.md
!.cursor/README.md
!.cursor/rules/**/*.md
!.cursor/rules/**/*.mdc

# Документы: в git — product/, operations/ (включая milestones), agents/
/docs/**
!/docs/product/
!/docs/product/**
!/docs/operations/
!/docs/operations/**
!/docs/agents/
!/docs/agents/**
!/docs/integrations/
!/docs/integrations/**

# Vite Ruby
/public/vite*
# node_modules уже выше; README разрешён через !/node_modules/README.md
# дубль без слэша ломал un-ignore — убран
*.local

