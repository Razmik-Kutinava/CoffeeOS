#!/bin/bash -e

if [ "${RELEASE_COMMAND:-}" = "1" ]; then
  echo "[docker-entrypoint] RELEASE_COMMAND=1 — booting Rails for fly:release..."
fi

# If running the rails server then create or migrate existing database
# (любые флаги после "server", напр. -b 0.0.0.0 — старый тест по двум последним аргументам ломался)
if [ "${1:-}" = "./bin/rails" ] && [ "${2:-}" = "server" ]; then
  if ! ./bin/rails db:prepare; then
    echo "[docker-entrypoint] WARN db:prepare failed — starting server anyway (DB may be temporarily unavailable)"
  fi
  ./bin/rails db:migrate:queue db:migrate:cache db:migrate:cable 2>/dev/null || true
  # Если заданы переменные — автоматически запустить первичную настройку
  if [ -n "${ADMIN_PASSWORD:-}" ]; then
    ./bin/rails setup:production || true
  fi
  # Создание тестовых пользователей только в не-production или по явному флагу
  if [ "${CREATE_TEST_USERS:-false}" = "true" ]; then
    ./bin/rails test:create_test_users || true
  fi
  # Fly demo-стенд (develop): идемпотентный сид при старте машины, если release_command не отработал.
  if [ "${DEMO_AUTO_SEED:-false}" = "true" ]; then
    ./bin/rails demo:seed || true
  fi
fi

exec "${@}"
